<UserControl x:Class="SampleApplicationV2.Views.StressTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Headline numbers: this is the slide-worthy part of the demo -->
        <Border Grid.Row="0" Background="#0D0D1A" BorderBrush="#333355" BorderThickness="1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="ROWS LOADED" Foreground="#8A90A0" FontSize="11"/>
                    <TextBlock x:Name="txtRows" Text="0" Foreground="#E6E6E6" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="FRAME TIME (avg)" Foreground="#8A90A0" FontSize="11"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtFrame" Text="-" Foreground="#00CC00" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text=" ms" Foreground="#8A90A0" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="FRAME TIME (p95)" Foreground="#8A90A0" FontSize="11"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtP95" Text="-" Foreground="#7FD1B9" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text=" ms" Foreground="#8A90A0" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="CELLS DRAWN / FRAME" Foreground="#8A90A0" FontSize="11"/>
                    <TextBlock x:Name="txtCells" Text="-" Foreground="#4A90D9" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="FRAMES PAINTED" Foreground="#8A90A0" FontSize="11"/>
                    <TextBlock x:Name="txtFrames" Text="0" Foreground="#C0C0C0" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MANAGED MEMORY" Foreground="#8A90A0" FontSize="11"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtMem" Text="-" Foreground="#C0C0C0" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text=" MB" Foreground="#8A90A0" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#16162A" BorderBrush="#333355" BorderThickness="1"
                Padding="14,10" Margin="0,10,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Load:" Foreground="#C0C0C0" VerticalAlignment="Center" Width="42"/>
                    <Button Content="1,000"     Click="Load_Click" Tag="1000"    Padding="12,4" Margin="0,0,6,0"/>
                    <Button Content="10,000"    Click="Load_Click" Tag="10000"   Padding="12,4" Margin="0,0,6,0"/>
                    <Button Content="100,000"   Click="Load_Click" Tag="100000"  Padding="12,4" Margin="0,0,6,0"
                            FontWeight="Bold"/>
                    <Button Content="1,000,000" Click="Load_Click" Tag="1000000" Padding="12,4" Margin="0,0,20,0"/>

                    <CheckBox x:Name="LiveTicks" Content="Live ticks (2,000 rows / 100 ms)"
                              Foreground="#C0C0C0" VerticalAlignment="Center" Margin="0,0,20,0"
                              Checked="LiveTicks_Changed" Unchecked="LiveTicks_Changed"/>
                    <Button Content="Auto-scroll" x:Name="AutoScrollButton" Click="AutoScroll_Click"
                            Padding="12,4" Margin="0,0,20,0"/>
                    <Button Content="Reset metrics" Click="ResetMetrics_Click" Padding="12,4"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#7FD1B9" FontFamily="Consolas"
                           FontSize="12" Margin="0,9,0,0"
                           Text="Press 100,000 to load the benchmark dataset, then scroll."/>
                <TextBlock Foreground="#8A90A0" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="Frame time is measured inside the grid itself (GridMetrics, Render.PaintSurface). It stays flat as the row count grows because only the rows inside the viewport are ever drawn - cost is proportional to VIEWPORT size, not DATASET size."/>
            </StackPanel>
        </Border>

        <skia:SkiaGridViewV2 x:Name="skiaGrid" Grid.Row="2"
                             CanUserSelectRows="True"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             ShowGridLines="True"
                             GridLinesColor="#2A2A3A"
                             RowBackground="#181818"
                             AlternatingRowBackground="#101018"
                             ForegroundColor="#E6E6E6"
                             SelectedRowBackground="#0072C6"
                             SKFontSize="12"
                             VerticalScrollBarVisible="Auto"
                             HorizontalScrollBarVisible="Auto">
            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Name="Id"     Header="#"       BindingPath="Id"            Width="80"  ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Name="Sym"    Header="Symbol"  BindingPath="Symbol"        Width="90"/>
                <skia:SKGridViewColumn Name="Bid"    Header="Bid"     BindingPath="Bid"           Width="90"  ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Name="Ask"    Header="Ask"     BindingPath="Ask"           Width="90"  ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Name="Last"   Header="Last"    BindingPath="Last"          Width="90"  ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Name="Chg"    Header="Chg%"    BindingPath="ChangePercent" Width="90"  ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Name="Vol"    Header="Volume"  BindingPath="Volume"        Width="110" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Name="Exch"   Header="Exch"    BindingPath="Exchange"      Width="70"  ContentAlignment="Center"/>
                <skia:SKGridViewColumn Name="Sector" Header="Sector"  BindingPath="Sector"        Width="130"/>
                <skia:SKGridViewColumn Name="Time"   Header="Updated" BindingPath="UpdatedText"   Width="110" ContentAlignment="Center"/>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>
    </Grid>
</UserControl>
