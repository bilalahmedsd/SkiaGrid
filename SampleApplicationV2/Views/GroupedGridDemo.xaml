<UserControl x:Class="SampleApplicationV2.Views.GroupedGridDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2"
             xmlns:local="clr-namespace:SampleApplicationV2">
    <UserControl.Resources>
        <!-- BindingProxy no longer needed — Freezable inheritance provides DataContext -->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Grouped Grid - Grouping, Expand/Collapse, Aggregation, Tree Rows"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Expand All" Click="ExpandAll_Click" Margin="2" Padding="8,4"/>
            <Button Content="Collapse All" Click="CollapseAll_Click" Margin="2" Padding="8,4"/>
            <Button Content="Add Items to Group" Click="AddToGroup_Click" Margin="2" Padding="8,4"/>
            <Button Content="Update Prices" Click="UpdatePrices_Click" Margin="2" Padding="8,4"/>
            <CheckBox x:Name="chkBorderSelect" Content="Border Selection" VerticalAlignment="Center" Margin="10,0,0,0"
                      Foreground="White" Checked="SelectionStyle_Changed" Unchecked="SelectionStyle_Changed"/>
            <!-- ExpandChanged demo: simulated market-data subscription driven by group expand state -->
            <TextBlock x:Name="txtSubscriptions" Text="Subscribed: -" Foreground="#4EC9B0" FontSize="11"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Grouped grid with aggregation, expand/collapse, tree items -->
        <skia:SkiaGridViewV2 x:Name="skiaGrid" Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItems="{Binding SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ChildProperty="Details"
                             ShowGridLines="True"
                             GridLinesColor="#444444"
                             RowBackground="#1A1A2E"
                             AlternatingRowBackground="#16213E"
                             ForegroundColor="#E0E0E0"
                             CanUserSelectRows="True"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             SKFontSize="13"
                             SKFontFamily="Segoe UI"
                             IsLiveSorting="True">

            <!-- Group Settings with aggregations -->
            <skia:SkiaGridViewV2.GroupSettings>
                <skia:SKGroupDefinition GroupBy="Name" Target="GroupColumn" RowBackground="#0F3460">
                    <skia:SKGroupDefinition.GroupCellTemplate>
                        <skia:SKGroupCellTemplate>
                            <skia:SKGroupCellTemplate.Setters>
                                <skia:SKSetter Property="Foreground" Value="#E0E0E0"/>
                            </skia:SKGroupCellTemplate.Setters>
                            <!-- Green foreground when sum > 0 -->
                            <skia:SkGroupDataTrigger BindingPath="Price" Aggregation="Sum" Operator="GreaterThan" Value="0">
                                <skia:SkGroupDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#1ED760"/>
                                </skia:SkGroupDataTrigger.Setters>
                            </skia:SkGroupDataTrigger>
                            <!-- Red foreground when sum <= 0 -->
                            <skia:SKGroupMultiTrigger>
                                <skia:SKGroupMultiTrigger.Conditions>
                                    <skia:SKGroupCondition BindingPath="Price" Aggregation="Sum" Operator="LessThanOrEqual" Value="0"/>
                                </skia:SKGroupMultiTrigger.Conditions>
                                <skia:SKGroupMultiTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#CE4758"/>
                                </skia:SKGroupMultiTrigger.Setters>
                            </skia:SKGroupMultiTrigger>
                        </skia:SKGroupCellTemplate>
                    </skia:SKGroupDefinition.GroupCellTemplate>
                    <skia:SKGroupDefinition.HeaderFields>
                        <!-- Sum of Price -->
                        <skia:SKGroupField BindingPath="Price" Aggregation="Sum" TargetColumns="Price">
                            <skia:SKGroupField.GroupCellTemplate>
                                <skia:SKGroupCellTemplate>
                                    <skia:SKGroupCellTemplate.Setters>
                                        <skia:SKSetter Property="BorderColor" Value="#533483"/>
                                    </skia:SKGroupCellTemplate.Setters>
                                    <skia:SkGroupDataTrigger BindingPath="Price" Aggregation="Sum" Operator="GreaterThan" Value="0">
                                        <skia:SkGroupDataTrigger.Setters>
                                            <skia:SKSetter Property="Foreground" Value="#1ED760"/>
                                        </skia:SkGroupDataTrigger.Setters>
                                    </skia:SkGroupDataTrigger>
                                    <skia:SKGroupMultiTrigger>
                                        <skia:SKGroupMultiTrigger.Conditions>
                                            <skia:SKGroupCondition BindingPath="Price" Aggregation="Sum" Operator="LessThanOrEqual" Value="0"/>
                                        </skia:SKGroupMultiTrigger.Conditions>
                                        <skia:SKGroupMultiTrigger.Setters>
                                            <skia:SKSetter Property="Foreground" Value="#CE4758"/>
                                        </skia:SKGroupMultiTrigger.Setters>
                                    </skia:SKGroupMultiTrigger>
                                </skia:SKGroupCellTemplate>
                            </skia:SKGroupField.GroupCellTemplate>
                        </skia:SKGroupField>
                        <!-- Sum of Quantity -->
                        <skia:SKGroupField BindingPath="Quantity" Aggregation="Sum" TargetColumns="Quantity"/>
                        <!-- Average Discount -->
                        <skia:SKGroupField BindingPath="Discount" Aggregation="Avg" TargetColumns="Discount"/>
                        <!-- Count of items -->
                        <skia:SKGroupField BindingPath="Id" Aggregation="Count" TargetColumns="Id"/>
                        <!-- Distinct categories -->
                        <skia:SKGroupField BindingPath="Category" Aggregation="Distinct" TargetColumns="Category"/>
                        <!-- Min Rating -->
                        <skia:SKGroupField BindingPath="Rating" Aggregation="Min" TargetColumns="Rating"/>
                        <!-- Max Supplier (by name) -->
                        <skia:SKGroupField BindingPath="SupplierName" Aggregation="Max" TargetColumns="Supplier"/>
                    </skia:SKGroupDefinition.HeaderFields>
                    <skia:SKGroupDefinition.ToggleSymbol>
                        <skia:SKGroupToggleSymbol Expand="[-]" Collapse="[+]" TargetColumns="Expand"
                                                  ShowGroupDetail="True" BackgroundColor="#533483" ForegroundColor="#ffffff"/>
                    </skia:SKGroupDefinition.ToggleSymbol>
                </skia:SKGroupDefinition>
            </skia:SkiaGridViewV2.GroupSettings>

            <!-- Row Template -->
            <skia:SkiaGridViewV2.RowTemplate>
                <skia:SKRowTemplate>
                    <skia:SKMultiTrigger>
                        <skia:SKMultiTrigger.Conditions>
                            <skia:SKCondition BindingPath="Price" Operator="GreaterThan" Value="500"/>
                            <skia:SKCondition BindingPath="IsActive" Operator="Equals" Value="True"/>
                        </skia:SKMultiTrigger.Conditions>
                        <skia:SKMultiTrigger.Setters>
                            <skia:SKSetter Property="Background" Value="#1A3A2A"/>
                            <skia:SKSetter Property="BorderColor" Value="#1ED760"/>
                        </skia:SKMultiTrigger.Setters>
                    </skia:SKMultiTrigger>
                </skia:SKRowTemplate>
            </skia:SkiaGridViewV2.RowTemplate>

            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Name="Expand" Header=" " Width="40" ContentAlignment="Center"
                                       CanUserSort="False" CanUserResize="False" CanUserReorder="False"
                                       IsExpandableColumnForChildRows="True"/>
                <skia:SKGridViewColumn Name="GroupColumn" Header="Group" BindingPath="Name" Width="120" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="ID" BindingPath="Id" Width="60" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Price" BindingPath="Price" Width="100" ContentAlignment="Right" Format="N2" ShowSubTotalOnSort="True">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKDataTrigger BindingPath="Price" Operator="GreaterThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#00CC00"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                            <skia:SKDataTrigger BindingPath="Price" Operator="LessThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#FF4444"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Header="Active" BindingPath="IsActive" Width="70" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Quantity" BindingPath="Quantity" Width="90" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Header="Discount" BindingPath="Discount" Width="90" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Header="Category" BindingPath="Category" Width="110" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="Rating" BindingPath="Rating" Width="70" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Supplier" BindingPath="SupplierName" Width="110" ContentAlignment="Left"/>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>
    </Grid>
</UserControl>
