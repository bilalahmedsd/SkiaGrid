<UserControl x:Class="SampleApplicationV2.Views.GlobalPositionSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2"
             xmlns:local="clr-namespace:SampleApplicationV2">
    <UserControl.Resources>
        <!-- BindingProxy no longer needed — Freezable inheritance provides DataContext -->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Global Position Summary - Grouped by Account, Aggregation, Expand/Collapse"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Expand All" Click="ExpandAll_Click" Margin="2" Padding="8,4"/>
            <Button Content="Collapse All" Click="CollapseAll_Click" Margin="2" Padding="8,4"/>
            <Button Content="Update Prices" Click="UpdatePrices_Click" Margin="2" Padding="8,4"/>
            <Button Content="Filter Account" Click="FilterAccount_Click" Margin="2" Padding="8,4"/>
            <Button Content="Clear Filter" Click="ClearFilter_Click" Margin="2" Padding="8,4"/>
            <CheckBox x:Name="chkTimerSort" Content="Timer Sort (3s)" VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="TimerSort_Changed" Unchecked="TimerSort_Changed" Foreground="White"/>
        </StackPanel>

        <!-- Position grid with grouping by Account, aggregation of PnL, Market Value.
             Density="Normal" opts OUT of the Compact default: a positions / account grid wants the
             roomier font+6 rows / font+12 header (17/23 px at an 11 px font), matching the reference
             terminal's positions window. Compact — the default — is the time-and-sales tape density,
             demonstrated in TimeAndSaleView. -->
        <skia:SkiaGridViewV2 x:Name="skiaGrid" Grid.Row="1"
                             ItemsSource="{Binding Positions}"
                             SelectedItems="{Binding SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ShowGridLines="True"
                             GridLinesColor="#2A2A2A"
                             RowBackground="#0D0D1A"
                             AlternatingRowBackground="#12122A"
                             ForegroundColor="#C0C0C0"
                             CanUserSelectRows="True"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             RetainSelectionOnLFocusLost="True"
                             Density="Normal"
                             SKFontSize="13"
                             SKFontFamily="Segoe UI"
                             IsLiveSorting="True"
                             SortEvery="{Binding SortEvery, UpdateSourceTrigger=PropertyChanged}"
                             IsDeferredScrollingEnabled="True">

            <!-- Group by Account -->
            <skia:SkiaGridViewV2.GroupSettings>
                <skia:SKGroupDefinition GroupBy="Account" Target="GroupColumn" RowBackground="#1A1A3E">
                    <skia:SKGroupDefinition.GroupCellTemplate>
                        <skia:SKGroupCellTemplate>
                            <skia:SKGroupCellTemplate.Setters>
                                <skia:SKSetter Property="Foreground" Value="#AAAAFF"/>
                            </skia:SKGroupCellTemplate.Setters>
                            <!-- Green when total PnL > 0 -->
                            <skia:SkGroupDataTrigger BindingPath="UnrealizedPnl" Aggregation="Sum" Operator="GreaterThan" Value="0">
                                <skia:SkGroupDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#1ED760"/>
                                </skia:SkGroupDataTrigger.Setters>
                            </skia:SkGroupDataTrigger>
                            <!-- Red when total PnL <= 0 -->
                            <skia:SKGroupMultiTrigger>
                                <skia:SKGroupMultiTrigger.Conditions>
                                    <skia:SKGroupCondition BindingPath="UnrealizedPnl" Aggregation="Sum" Operator="LessThanOrEqual" Value="0"/>
                                </skia:SKGroupMultiTrigger.Conditions>
                                <skia:SKGroupMultiTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#CE4758"/>
                                </skia:SKGroupMultiTrigger.Setters>
                            </skia:SKGroupMultiTrigger>
                        </skia:SKGroupCellTemplate>
                    </skia:SKGroupDefinition.GroupCellTemplate>

                    <skia:SKGroupDefinition.HeaderFields>
                        <!-- Sum of Market Value -->
                        <skia:SKGroupField BindingPath="MarketValue" Aggregation="Sum" TargetColumns="MktVal"/>
                        <!-- Sum of Unrealized PnL -->
                        <skia:SKGroupField BindingPath="UnrealizedPnl" Aggregation="Sum" TargetColumns="UnrlPnl">
                            <skia:SKGroupField.GroupCellTemplate>
                                <skia:SKGroupCellTemplate>
                                    <skia:SkGroupDataTrigger BindingPath="UnrealizedPnl" Aggregation="Sum" Operator="GreaterThan" Value="0">
                                        <skia:SkGroupDataTrigger.Setters>
                                            <skia:SKSetter Property="Foreground" Value="#1ED760"/>
                                        </skia:SkGroupDataTrigger.Setters>
                                    </skia:SkGroupDataTrigger>
                                    <skia:SKGroupMultiTrigger>
                                        <skia:SKGroupMultiTrigger.Conditions>
                                            <skia:SKGroupCondition BindingPath="UnrealizedPnl" Aggregation="Sum" Operator="LessThanOrEqual" Value="0"/>
                                        </skia:SKGroupMultiTrigger.Conditions>
                                        <skia:SKGroupMultiTrigger.Setters>
                                            <skia:SKSetter Property="Foreground" Value="#CE4758"/>
                                        </skia:SKGroupMultiTrigger.Setters>
                                    </skia:SKGroupMultiTrigger>
                                </skia:SKGroupCellTemplate>
                            </skia:SKGroupField.GroupCellTemplate>
                        </skia:SKGroupField>
                        <!-- Sum of Realized PnL -->
                        <skia:SKGroupField BindingPath="RealizedPnl" Aggregation="Sum" TargetColumns="RlzPnl"/>
                        <!-- Sum of Total PnL -->
                        <skia:SKGroupField BindingPath="TotalPnl" Aggregation="Sum" TargetColumns="TtlPnl">
                            <skia:SKGroupField.GroupCellTemplate>
                                <skia:SKGroupCellTemplate>
                                    <skia:SkGroupDataTrigger BindingPath="TotalPnl" Aggregation="Sum" Operator="GreaterThan" Value="0">
                                        <skia:SkGroupDataTrigger.Setters>
                                            <skia:SKSetter Property="Foreground" Value="#1ED760"/>
                                        </skia:SkGroupDataTrigger.Setters>
                                    </skia:SkGroupDataTrigger>
                                    <skia:SKGroupMultiTrigger>
                                        <skia:SKGroupMultiTrigger.Conditions>
                                            <skia:SKGroupCondition BindingPath="TotalPnl" Aggregation="Sum" Operator="LessThanOrEqual" Value="0"/>
                                        </skia:SKGroupMultiTrigger.Conditions>
                                        <skia:SKGroupMultiTrigger.Setters>
                                            <skia:SKSetter Property="Foreground" Value="#CE4758"/>
                                        </skia:SKGroupMultiTrigger.Setters>
                                    </skia:SKGroupMultiTrigger>
                                </skia:SKGroupCellTemplate>
                            </skia:SKGroupField.GroupCellTemplate>
                        </skia:SKGroupField>
                        <!-- Count of positions -->
                        <skia:SKGroupField BindingPath="Symbol" Aggregation="Count" TargetColumns="Symbol"/>
                    </skia:SKGroupDefinition.HeaderFields>

                    <skia:SKGroupDefinition.ToggleSymbol>
                        <skia:SKGroupToggleSymbol Expand="[-]" Collapse="[+]" TargetColumns="Toggle"
                                                  ShowGroupDetail="True" BackgroundColor="#2A2A5E" ForegroundColor="#AAAAFF"/>
                    </skia:SKGroupDefinition.ToggleSymbol>
                </skia:SKGroupDefinition>
            </skia:SkiaGridViewV2.GroupSettings>

            <!-- Row coloring: long vs short position -->
            <skia:SkiaGridViewV2.RowTemplate>
                <skia:SKRowTemplate>
                    <skia:SKDataTrigger BindingPath="Position" Operator="GreaterThan" Value="0">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Foreground" Value="#6699CC"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                    <skia:SKDataTrigger BindingPath="Position" Operator="LessThan" Value="0">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Foreground" Value="#CC6666"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                </skia:SKRowTemplate>
            </skia:SkiaGridViewV2.RowTemplate>

            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Name="Toggle" Header=" " Width="40" ContentAlignment="Center"
                                       CanUserSort="False" CanUserResize="False" CanUserReorder="False"/>
                <skia:SKGridViewColumn Name="GroupColumn" Header="Account" BindingPath="Account" Width="100" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="Symbol" BindingPath="Symbol" Width="80" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="Pos" BindingPath="Position" Width="80" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Header="Avg Cost" BindingPath="AvgCost" Width="90" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Header="Last" BindingPath="LastPrice" Width="80" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Name="MktVal" Header="Mkt Value" BindingPath="MarketValue" Width="110" ContentAlignment="Right" Format="N0" ShowSubTotalOnSort="True"/>
                <skia:SKGridViewColumn Name="UnrlPnl" Header="Unrl P&amp;L" BindingPath="UnrealizedPnl" Width="100" ContentAlignment="Right" Format="N2" ShowSubTotalOnSort="True">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKCellTemplate.Setters>
                                <skia:SKSetter Property="Foreground" ValuePath="PnlColor"/>
                            </skia:SKCellTemplate.Setters>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Name="RlzPnl" Header="Rlz P&amp;L" BindingPath="RealizedPnl" Width="100" ContentAlignment="Right" Format="N2" ShowSubTotalOnSort="True"/>
                <skia:SKGridViewColumn Name="TtlPnl" Header="Total P&amp;L" BindingPath="TotalPnl" Width="100" ContentAlignment="Right" Format="N2" ShowSubTotalOnSort="True">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKDataTrigger BindingPath="TotalPnl" Operator="GreaterThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#00CC00"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                            <skia:SKDataTrigger BindingPath="TotalPnl" Operator="LessThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#FF4444"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Header="Currency" BindingPath="Currency" Width="70" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Class" BindingPath="AssetClass" Width="60" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Exchange" BindingPath="Exchange" Width="80" ContentAlignment="Center"/>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>
    </Grid>
</UserControl>
