<Window x:Class="SampleApplicationV2.Views.GpsDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2"
        Title="GPS Demo — Global Position Summary (opens grouped + sorted)"
        Height="640" Width="1080"
        Background="#12122A"
        UseLayoutRounding="True">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Caption: what to look at (no clicks needed) -->
        <Border Grid.Row="0" Background="#1A1A2E" BorderBrush="#333355" BorderThickness="1"
                CornerRadius="3" Padding="10,7" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="Global Position Summary — grouped by Account, sorted by Inst (Equity / Options subtotals)"
                           FontWeight="Bold" FontSize="14" Foreground="#1ED760"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#C0C0C0" FontSize="12"
                           Text="This window opens ALREADY grouped by Account and ALREADY sorted by Inst — no clicks needed. What to look at: the grand totals (Total Equity / Total Options, summed across ALL accounts) appear exactly ONCE at the very top; then each Account group has exactly one subtotal per instrument type right under its header. There is NO duplicate grand-total block reappearing above the 2nd / 3rd account group (the just-fixed distinct-subtotal behavior). Also: this group has ShowSubtotalsWhenCollapsed=True — click an account's [+] to collapse it and its Equity/Options subtotal rows stay visible under the header while the individual position rows hide."/>
            </StackPanel>
        </Border>

        <!-- GPS main grid — mirrors P1 GlobalPositionSummaryView.xaml main grid config:
             GroupBy Account (Target=GroupColumn), Sum HeaderFields on Position / DailyPl / Value,
             a Distinct HeaderField on InstrumentType (Target=InstCol), and the Inst column with
             ShowSubTotalOnSort=True. The Loaded handler applies the Inst sort so the distinct-subtotal
             flatten path is exercised on open. -->
        <skia:SkiaGridViewV2 x:Name="skiaGrid" Grid.Row="1"
                             ItemsSource="{Binding Positions}"
                             SelectedItems="{Binding SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ShowGridLines="True"
                             GridLinesColor="#2A2A2A"
                             RowBackground="#0D0D1A"
                             AlternatingRowBackground="#12122A"
                             ForegroundColor="#C0C0C0"
                             CanUserSelectRows="True"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             CanUserReorderColumns="True"
                             RetainSelectionOnLFocusLost="True"
                             SKFontSize="13"
                             SKFontFamily="Segoe UI"
                             IsLiveSorting="True">

            <!-- Group by Account. Mirrors P1 GPS main grid (GlobalPositionSummaryView.xaml:392-408):
                 Sum on Position/DailyPl/Value + a Distinct on InstrumentType targeting the Inst column. -->
            <skia:SkiaGridViewV2.GroupSettings>
                <skia:SKGroupDefinition GroupBy="Account" Target="GroupColumn" RowBackground="#1A1A3E"
                                        ShowSubtotalsWhenCollapsed="True">
                    <skia:SKGroupDefinition.GroupCellTemplate>
                        <skia:SKGroupCellTemplate>
                            <skia:SKGroupCellTemplate.Setters>
                                <skia:SKSetter Property="Foreground" Value="#AAAAFF"/>
                            </skia:SKGroupCellTemplate.Setters>
                        </skia:SKGroupCellTemplate>
                    </skia:SKGroupDefinition.GroupCellTemplate>

                    <skia:SKGroupDefinition.HeaderFields>
                        <skia:SKGroupField BindingPath="Position" Aggregation="Sum"      TargetColumns="PosCol"/>
                        <skia:SKGroupField BindingPath="DailyPl"  Aggregation="Sum"      TargetColumns="DailyPlCol"/>
                        <skia:SKGroupField BindingPath="Value"    Aggregation="Sum"      TargetColumns="ValueCol"/>
                        <!-- Distinct instrument mix in the account header's Inst cell; also enables the
                             grid's native Inst-sort subtotals (ShowSubTotalOnSort on the Inst column). -->
                        <skia:SKGroupField BindingPath="InstrumentType" Aggregation="Distinct" TargetColumns="InstCol"/>
                    </skia:SKGroupDefinition.HeaderFields>

                    <skia:SKGroupDefinition.ToggleSymbol>
                        <skia:SKGroupToggleSymbol Expand="[-]" Collapse="[+]" TargetColumns="Toggle"
                                                  BackgroundColor="#2A2A5E" ForegroundColor="#AAAAFF"/>
                    </skia:SKGroupDefinition.ToggleSymbol>
                </skia:SKGroupDefinition>
            </skia:SkiaGridViewV2.GroupSettings>

            <!-- Row coloring: long vs short position (GPS-like). -->
            <skia:SkiaGridViewV2.RowTemplate>
                <skia:SKRowTemplate>
                    <skia:SKDataTrigger BindingPath="Position" Operator="LessThan" Value="0">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Foreground" Value="#CC6666"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                </skia:SKRowTemplate>
            </skia:SkiaGridViewV2.RowTemplate>

            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Name="Toggle"      Header=" "          Width="40"  ContentAlignment="Center"
                                       CanUserSort="False" CanUserResize="False" CanUserReorder="False"/>
                <skia:SKGridViewColumn Name="GroupColumn" Header="Acct"        BindingPath="Account"        Width="110" ContentAlignment="Left"/>
                <!-- ShowSubTotalOnSort: sorting by Inst inserts "Total Equity" / "Total Options"
                     subtotal rows per account group (mirrors P1 GlobalPositionSummaryView.xaml:428). -->
                <skia:SKGridViewColumn Name="InstCol"     Header="Inst"        BindingPath="InstrumentType" Width="110" ContentAlignment="Left"
                                       ShowSubTotalOnSort="True"/>
                <skia:SKGridViewColumn Name="InstCodeCol" Header="Inst Code"   BindingPath="InstCode"       Width="90"  ContentAlignment="Left"/>
                <skia:SKGridViewColumn Name="DescCol"     Header="Description" BindingPath="Description"    Width="180" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Name="SymCol"      Header="Sym"         BindingPath="Symbol"         Width="90"  ContentAlignment="Left"/>
                <skia:SKGridViewColumn Name="PosCol"      Header="Pos"         BindingPath="Position"       Width="90"  ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Name="ValueCol"    Header="$Value"      BindingPath="Value"          Width="120" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Name="DailyPlCol"  Header="$Daily P/L"  BindingPath="DailyPl"        Width="120" ContentAlignment="Right" Format="N2">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKDataTrigger BindingPath="DailyPl" Operator="GreaterThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#1ED760"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                            <skia:SKDataTrigger BindingPath="DailyPl" Operator="LessThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#FF4444"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>
    </Grid>
</Window>
