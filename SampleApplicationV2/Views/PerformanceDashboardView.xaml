<UserControl x:Class="SampleApplicationV2.Views.PerformanceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2"
             xmlns:local="clr-namespace:SampleApplicationV2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Key Indicators -->
        <Border Grid.Row="0" Background="#0D0D1A" BorderBrush="#333355" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <TextBlock Text="Frame: " Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtFrameTime" Text="—" FontSize="22" FontWeight="Bold" Foreground="#00CC00" VerticalAlignment="Center"/>
                    <TextBlock Text="ms" Foreground="#888888" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <TextBlock Text="FPS: " Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtFPS" Text="—" FontSize="18" FontWeight="Bold" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <TextBlock Text="Calls: " Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalCalls" Text="0" FontSize="16" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <TextBlock Text="Mem: " Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtMemory" Text="—" FontSize="16" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <TextBlock Text="Paints: " Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPaintCache" Text="0" FontSize="16" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Row 1: Counters panel (non-timing metrics) -->
        <Border Grid.Row="1" Background="#0A0A18" BorderBrush="#333355" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Cells Drawn: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCellsDrawn" Text="0" FontSize="13" FontWeight="Bold" Foreground="#4A90D9" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Triggers Evaluated: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTriggersEvaluated" Text="0" FontSize="13" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Triggers Matched: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTriggersMatched" Text="0" FontSize="13" Foreground="#1ED760" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Paint Cache Hits: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPaintHits" Text="0" FontSize="13" Foreground="#1ED760" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Paint Cache Miss: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPaintMisses" Text="0" FontSize="13" Foreground="#FF6666" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Reflection Calls: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtReflectionCalls" Text="0" FontSize="13" Foreground="#FFAA00" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Filter Evaluations: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtFilterEvaluations" Text="0" FontSize="13" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Collection Changes: " Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCollectionChanges" Text="0" FontSize="13" Foreground="#C0C0C0" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Row 2: Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5" Background="#0D0D1A">
            <TextBlock Text="Performance Profiling Dashboard" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" Foreground="#C0C0C0" Margin="0,0,20,0"/>
            <CheckBox x:Name="chkEnabled" Content="Enable Metrics" IsChecked="True" VerticalAlignment="Center"
                      Foreground="White" Margin="0,0,15,0" Checked="EnableChanged" Unchecked="EnableChanged"/>
            <Button Content="Reset" Click="Reset_Click" Margin="2" Padding="8,4"/>
            <Button Content="Snapshot to Debug" Click="Snapshot_Click" Margin="2" Padding="8,4"/>
            <TextBlock Text="Refresh:" VerticalAlignment="Center" Foreground="#888888" Margin="15,0,5,0"/>
            <ComboBox x:Name="cmbRefreshRate" Width="80" Margin="2" SelectionChanged="RefreshRate_Changed">
                <ComboBoxItem Content="250ms" Tag="250"/>
                <ComboBoxItem Content="500ms" Tag="500"/>
                <ComboBoxItem Content="1000ms" Tag="1000" IsSelected="True"/>
                <ComboBoxItem Content="2000ms" Tag="2000"/>
            </ComboBox>
        </StackPanel>

        <!-- Row 3: Metrics Grid (SkiaGridViewV2 dogfooding!) -->
        <skia:SkiaGridViewV2 x:Name="metricsGrid" Grid.Row="3"
                             ItemsSource="{Binding Metrics}"
                             ShowGridLines="True"
                             GridLinesColor="#2A2A2A"
                             RowBackground="#0D0D1A"
                             AlternatingRowBackground="#12122A"
                             ForegroundColor="#C0C0C0"
                             CanUserSelectRows="True"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             SKFontSize="13"
                             SKFontFamily="Consolas"
                             IsLiveSorting="True">

            <!-- Color status rows -->
            <skia:SkiaGridViewV2.RowTemplate>
                <skia:SKRowTemplate>
                    <skia:SKDataTrigger BindingPath="Status" Operator="Equals" Value="SLOW">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Background" Value="#2A0A0A"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                    <skia:SKDataTrigger BindingPath="Status" Operator="Equals" Value="WARN">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Background" Value="#2A2A0A"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                </skia:SKRowTemplate>
            </skia:SkiaGridViewV2.RowTemplate>

            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Header="Operation" BindingPath="Operation" Width="200" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="Calls" BindingPath="Calls" Width="80" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Header="Avg (ms)" BindingPath="AvgMs" Width="90" ContentAlignment="Right" Format="N3"/>
                <skia:SKGridViewColumn Header="Min (ms)" BindingPath="MinMs" Width="90" ContentAlignment="Right" Format="N3"/>
                <skia:SKGridViewColumn Header="Max (ms)" BindingPath="MaxMs" Width="90" ContentAlignment="Right" Format="N3"/>
                <skia:SKGridViewColumn Header="Last (ms)" BindingPath="LastMs" Width="90" ContentAlignment="Right" Format="N3"/>
                <skia:SKGridViewColumn Header="Total (ms)" BindingPath="TotalMs" Width="100" ContentAlignment="Right" Format="N1"/>
                <skia:SKGridViewColumn Header="Budget (ms)" BindingPath="ThresholdMs" Width="90" ContentAlignment="Right" Format="N1"/>
                <skia:SKGridViewColumn Header="Status" BindingPath="Status" Width="70" ContentAlignment="Center">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKCellTemplate.Setters>
                                <skia:SKSetter Property="Foreground" ValuePath="StatusColor"/>
                            </skia:SKCellTemplate.Setters>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>
    </Grid>
</UserControl>
