<UserControl x:Class="SampleApplicationV2.Views.BasicGridDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2"
             xmlns:local="clr-namespace:SampleApplicationV2">
    <UserControl.Resources>
        <!-- BindingProxy no longer needed — Freezable inheritance provides DataContext -->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Basic Grid Demo - Normal Rows, Styling, Selection, Filtering"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Add 5 Items" Click="AddItems_Click" Margin="2" Padding="8,4"/>
            <Button Content="Remove Selected" Click="RemoveSelected_Click" Margin="2" Padding="8,4"/>
            <Button Content="Insert Row" Click="InsertRow_Click" Margin="2" Padding="8,4"/>
            <Button Content="▲ Move Up" Click="MoveUp_Click" Margin="2" Padding="8,4"/>
            <Button Content="▼ Move Down" Click="MoveDown_Click" Margin="2" Padding="8,4"/>
            <Button Content="Select All" Click="SelectAll_Click" Margin="2" Padding="8,4"/>
            <Button Content="Filter Active Only" Click="FilterActive_Click" Margin="2" Padding="8,4"/>
            <Button Content="Clear Filter" Click="ClearFilter_Click" Margin="2" Padding="8,4"/>
            <Button Content="Copy Selected" Click="CopySelected_Click" Margin="2" Padding="8,4"/>
            <CheckBox x:Name="chkBorderSelect" Content="Border Selection" VerticalAlignment="Center" Margin="10,0,0,0"
                      Foreground="White" Checked="SelectionStyle_Changed" Unchecked="SelectionStyle_Changed"/>
        </StackPanel>

        <!-- Grid with styling, row/cell templates, selection -->
        <skia:SkiaGridViewV2 x:Name="skiaGrid" Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItems="{Binding SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ShowGridLines="True"
                             GridLinesColor="#333333"
                             RowBackground="#1E1E2E"
                             AlternatingRowBackground="#252535"
                             ForegroundColor="#E0E0E0"
                             CanUserSelectRows="True"
                             CanUserReorderColumns="True"
                             CanUserResizeColumns="True"
                             CanUserSortColumns="True"
                             HorizontalScrollBarVisible="Visible"
                             VerticalScrollBarVisible="Visible" 
                             RetainSelectionOnLFocusLost="True"
                             SKFontSize="13"
                             SKFontFamily="Segoe UI"
                             SKFontStyle="Normal"
                             IsLiveSorting="True">

            <!-- Row Template with conditional styling -->
            <skia:SkiaGridViewV2.RowTemplate>
                <skia:SKRowTemplate>
                    <!-- Highlight active rows -->
                    <skia:SKDataTrigger BindingPath="IsActive" Operator="Equals" Value="True">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Background" Value="#1A3A1A"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                    <!-- Highlight deleted rows -->
                    <skia:SKDataTrigger BindingPath="IsDeleted" Operator="Equals" Value="True">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Background" Value="#3A1A1A"/>
                            <skia:SKSetter Property="Foreground" Value="#FF6666"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                </skia:SKRowTemplate>
            </skia:SkiaGridViewV2.RowTemplate>

            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Header="ID" BindingPath="Id" Width="60" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Name" BindingPath="Name" Width="120" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="Price" BindingPath="Price" Width="100" ContentAlignment="Right" Format="N2">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKDataTrigger BindingPath="Price" Operator="GreaterThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#00CC00"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                            <skia:SKDataTrigger BindingPath="Price" Operator="LessThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#FF4444"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Header="Active" BindingPath="IsActive" Width="70" ContentAlignment="Center" IsCheckboxColumn="True"/>
                <skia:SKGridViewColumn Header="Quantity" BindingPath="Quantity" Width="80" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Header="Discount" BindingPath="Discount" Width="90" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Header="Category" BindingPath="Category" Width="100" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="Rating" BindingPath="Rating" Width="70" ContentAlignment="Center">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKDataTrigger BindingPath="Rating" Operator="GreaterThanOrEqual" Value="8">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#FFD700"/>
                                    <skia:SKSetter Property="Background" Value="#2A2A1A"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Header="Supplier" BindingPath="SupplierName" Width="110" ContentAlignment="Left"/>
                <skia:SKGridViewColumn Header="In Stock" BindingPath="InStock" Width="80" ContentAlignment="Center" IsCheckboxColumn="True"/>
                <skia:SKGridViewColumn Header="Created" BindingPath="CreatedAt" Width="100" ContentAlignment="Center" Format="MM/dd/yyyy"/>
                <skia:SKGridViewColumn Header="Deleted" BindingPath="IsDeleted" Width="70" ContentAlignment="Center"/>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>
    </Grid>
</UserControl>
