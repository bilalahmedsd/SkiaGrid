<UserControl x:Class="SampleApplicationV2.Views.RowDragView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Row drag" FontSize="16" FontWeight="Bold" Foreground="#E6E6E6"/>
            <TextBlock TextWrapping="Wrap" Foreground="#9AA0B0" Margin="0,4,0,0"
                       Text="DragOut (default here): open the drop-target window, then drag a row or a cell out of the grid and drop it there — or into Excel, Notepad, any text box. Nothing moves inside the grid. Reorder / Notify are the in-grid modes instead: they draw an insertion line and move (or just report) the row within this grid. Ctrl+click or Shift+click several rows first to drag them as a block; Escape abandons a drag."/>
        </StackPanel>

        <Border Grid.Row="1" Background="#16162A" BorderBrush="#333355" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mode:" Foreground="#C0C0C0" VerticalAlignment="Center" Width="60"/>
                    <ComboBox x:Name="ModeBox" Width="130" SelectionChanged="ModeBox_Changed">
                        <ComboBoxItem Content="DragOut" IsSelected="True"/>
                        <ComboBoxItem Content="Reorder"/>
                        <ComboBoxItem Content="Notify"/>
                        <ComboBoxItem Content="None"/>
                    </ComboBox>
                    <Button x:Name="OpenTargetButton" Content="Open drop-target window"
                            Click="OpenTarget_Click" Margin="10,0,0,0" Padding="10,3"/>

                    <TextBlock Text="Indicator:" Foreground="#C0C0C0" VerticalAlignment="Center" Width="70" Margin="20,0,0,0"/>
                    <ComboBox x:Name="ColorBox" Width="110" SelectionChanged="ColorBox_Changed">
                        <ComboBoxItem Content="default" IsSelected="True"/>
                        <ComboBoxItem Content="#FF6E00"/>
                        <ComboBoxItem Content="#00E07A"/>
                    </ComboBox>

                    <CheckBox x:Name="SortOn" Content="Sort by Symbol (blocks reorder)"
                              Foreground="#C0C0C0" VerticalAlignment="Center" Margin="20,0,0,0"
                              Checked="SortOn_Changed" Unchecked="SortOn_Changed"/>

                    <CheckBox x:Name="LiveTicks" Content="Live ticks (250 ms)"
                              Foreground="#C0C0C0" VerticalAlignment="Center" Margin="20,0,0,0"
                              Checked="LiveTicks_Changed" Unchecked="LiveTicks_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="VetoDrag" Content="Cancel every drag in RowDragStarting"
                              Foreground="#C0C0C0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="HandleDrop" Content="Handle the drop myself (append instead of insert)"
                              Foreground="#C0C0C0" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Content="Reset order" Click="Reset_Click" Margin="20,0,0,0" Padding="10,3"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Foreground="#E6E6E6" FontFamily="Consolas" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#555577" BorderThickness="1"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <skia:SkiaGridViewV2 x:Name="skiaGrid"
                                     Width="420" Height="280"
                                     RowDragMode="DragOut"
                                     CanUserSelectRows="True"
                                     VerticalScrollBarVisible="Auto"
                                     HorizontalScrollBarVisible="Hidden"
                                     RowBackground="#181818"
                                     AlternatingRowBackground="#0C0C0C"
                                     ForegroundColor="#E6E6E6"
                                     SelectedRowBackground="#0072C6">
                    <skia:SkiaGridViewV2.Columns>
                        <skia:SKGridViewColumn Name="Rank" Header="#" BindingPath="Rank" Width="40" ContentAlignment="Right"/>
                        <skia:SKGridViewColumn Name="Sym" Header="Symbol" BindingPath="Symbol" Width="90"/>
                        <skia:SKGridViewColumn Name="Last" Header="Last" BindingPath="Last" Width="90" Format="N2" ContentAlignment="Right"/>
                        <skia:SKGridViewColumn Name="Chg" Header="Chg%" BindingPath="ChangePercent" Width="90" Format="N2" ContentAlignment="Right"/>
                        <skia:SKGridViewColumn Name="Vol" Header="Volume" BindingPath="Volume" Width="100" Format="N0" ContentAlignment="Right"/>
                    </skia:SkiaGridViewV2.Columns>
                </skia:SkiaGridViewV2>
            </Border>

            <Border Grid.Column="1" Background="#0D0D1A" BorderBrush="#333355" BorderThickness="1"
                    Margin="10,0,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Event log" Foreground="#9AA0B0" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LogText" Foreground="#7FD1B9" FontFamily="Consolas" FontSize="11"
                               TextWrapping="NoWrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
