<UserControl x:Class="SampleApplicationV2.Views.MultiWindowTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LaunchBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource LaunchBtn}">
            <Setter Property="Background" Value="#5A1A1A"/>
            <Setter Property="BorderBrush" Value="#FF4444"/>
        </Style>
        <Style x:Key="StressBtn" TargetType="Button" BasedOn="{StaticResource LaunchBtn}">
            <Setter Property="Background" Value="#1A4A2A"/>
            <Setter Property="BorderBrush" Value="#1ED760"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0C0C0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F0F1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Background="#1A1A2E" Padding="15,10" BorderBrush="#333355" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Multi-Window Stress Test" FontWeight="Bold" FontSize="16" Foreground="#1ED760"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0">
                    Verify the multi-window fix: opens additional windows with live-updating grids.
                    Before the fix, the selected row would flicker because all grids shared a single static
                    selection HashSet. Click a row in any window — the highlight should stay solid while every
                    other window keeps streaming data and selecting/highlighting independently.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Launch buttons -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Single-window launches -->
            <Border Grid.Column="0" Background="#1A1A2E" BorderBrush="#333355" BorderThickness="1" Padding="10" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="LAUNCH ONE WINDOW" FontWeight="Bold" Foreground="#4A90D9" FontSize="12" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Watchlist (live ticks)" Click="OpenWatchlist_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Time &amp; Sales (rolling)" Click="OpenTimeAndSale_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Trading Monitor (orders)" Click="OpenTradingMonitor_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Options Chain (greeks)" Click="OpenOptionsChain_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Grouped Grid" Click="OpenGroupedGrid_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Basic Grid" Click="OpenBasicGrid_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Position Summary" Click="OpenPositionSummary_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="+ Performance Dashboard" Click="OpenPerformance_Click"
                            ToolTip="Open the metrics dashboard in its own window so you can watch numbers while other test windows run"/>
                </StackPanel>
            </Border>

            <!-- Stress-test scenarios -->
            <Border Grid.Column="1" Background="#1A1A2E" BorderBrush="#1ED760" BorderThickness="1" Padding="10" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="STRESS SCENARIOS" FontWeight="Bold" Foreground="#1ED760" FontSize="12" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource StressBtn}" Content="Tile 2 Windows (W + T&amp;S)" Click="Tile2_Click"
                            ToolTip="Opens Watchlist + Time &amp; Sales side-by-side"/>
                    <Button Style="{StaticResource StressBtn}" Content="Tile 4 Windows (full grid)" Click="Tile4_Click"
                            ToolTip="Opens 4 different live views in a 2x2 layout"/>
                    <Button Style="{StaticResource StressBtn}" Content="Tile 6 Windows (heavy)" Click="Tile6_Click"
                            ToolTip="Opens 6 windows. Watch all selections stay solid while every grid streams updates"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="#888">
                        Tip: click rows in different windows. Each window's selection should stay rock-solid.
                        With the bug, the highlighted row would blink/disappear randomly as windows repaint.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Cleanup + status -->
            <Border Grid.Column="2" Background="#1A1A2E" BorderBrush="#333355" BorderThickness="1" Padding="10" Margin="3" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="MANAGE WINDOWS" FontWeight="Bold" Foreground="#4A90D9" FontSize="12" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource DangerBtn}" Content="Close ALL Test Windows" Click="CloseAll_Click"/>
                    <Button Style="{StaticResource LaunchBtn}" Content="Close LAST Window"
                            Click="CloseLast_Click" ToolTip="Test the per-instance dispose: closing one window must not affect the others."/>
                    <TextBlock Margin="0,12,0,0" FontSize="11">
                        <Run Text="Open test windows: " Foreground="#888"/>
                        <Run x:Name="txtCount" Text="0" Foreground="#1ED760" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock x:Name="txtStatus" Margin="0,4,0,0" FontSize="11" Foreground="#888"
                               TextWrapping="Wrap" Text="No test windows open"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Verification checklist -->
        <Border Grid.Row="2" Margin="15,5,15,5" Background="#0A0A14" BorderBrush="#333355" BorderThickness="1" CornerRadius="3" Padding="15">
            <StackPanel>
                <TextBlock Text="VERIFICATION CHECKLIST" FontWeight="Bold" FontSize="13" Foreground="#4A90D9" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Margin="0,3" FontSize="12">
                    <Run Text="✓" Foreground="#1ED760" FontWeight="Bold"/>
                    <Run Text=" Selection persistence: click a row in Window A. While Window B streams ticks, Window A's selected row should stay highlighted (no flicker)."/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,3" FontSize="12">
                    <Run Text="✓" Foreground="#1ED760" FontWeight="Bold"/>
                    <Run Text=" Independent selections: select different rows in each window. Each window's highlight is independent and persistent."/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,3" FontSize="12">
                    <Run Text="✓" Foreground="#1ED760" FontWeight="Bold"/>
                    <Run Text=" Disposal safety: select a row in Window A, then close Window B (or several others). Window A's selection and rendering must continue working — no blank cells, no color corruption, no crashes."/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,3" FontSize="12">
                    <Run Text="✓" Foreground="#1ED760" FontWeight="Bold"/>
                    <Run Text=" Timer-based highlighting (Watchlist Timer mode): change-flash highlights persist for their full Duration in every window independently."/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,3" FontSize="12">
                    <Run Text="✓" Foreground="#1ED760" FontWeight="Bold"/>
                    <Run Text=" Grouped grid (in another window): expand/collapse works, group totals refresh, and selection on group rows stays stable."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0D0D1A" BorderBrush="#333355" BorderThickness="0,1,0,0" Padding="15,6">
            <TextBlock FontSize="11" Foreground="#666"
                       Text="Each launched window owns its own SkiaRenderer + CellRenderer. Static caches (SKPaintCache, SKTriggerStateCache) are refcounted so closing one window doesn't free state in others."/>
        </Border>
    </Grid>
</UserControl>
