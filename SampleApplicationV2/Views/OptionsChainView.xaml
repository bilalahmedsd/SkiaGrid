<UserControl x:Class="SampleApplicationV2.Views.OptionsChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharpControlV2;assembly=SkiaSharpControlV2"
             xmlns:local="clr-namespace:SampleApplicationV2">
    <UserControl.Resources>
        <!-- BindingProxy no longer needed — Freezable inheritance provides DataContext -->
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Options Chain - ITM Highlighting, Greeks, Timer Triggers"
                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Text="AAPL @ $178.50" FontSize="14" VerticalAlignment="Center" Foreground="#4A90D9" Margin="0,0,20,0"/>
            <Button Content="Update Prices" Click="UpdatePrices_Click" Margin="2" Padding="8,4"/>
            <Button Content="Filter ITM Only" Click="FilterITM_Click" Margin="2" Padding="8,4"/>
            <Button Content="Clear Filter" Click="ClearFilter_Click" Margin="2" Padding="8,4"/>
        </StackPanel>

        <!-- CALLS label -->
        <TextBlock Grid.Row="1" Text="CALLS" FontWeight="Bold" FontSize="12" Foreground="#4A90D9" Margin="10,5"/>

        <!-- Calls Grid -->
        <skia:SkiaGridViewV2 x:Name="callsGrid" Grid.Row="2"
                             ItemsSource="{Binding Calls}"
                             SelectedItems="{Binding SelectedCalls, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ShowGridLines="True"
                             GridLinesColor="#2A2A2A"
                             RowBackground="#0D0D1A"
                             AlternatingRowBackground="#12122A"
                             ForegroundColor="#C0C0C0"
                             CanUserSelectRows="True"
                             CanUserSortColumns="True"
                             CanUserResizeColumns="True"
                             SKFontSize="12"
                             SKFontFamily="Segoe UI"
                             IsLiveSorting="True">

            <!-- ITM highlighting -->
            <skia:SkiaGridViewV2.RowTemplate>
                <skia:SKRowTemplate>
                    <skia:SKDataTrigger BindingPath="IsITM" Operator="Equals" Value="True">
                        <skia:SKDataTrigger.Setters>
                            <skia:SKSetter Property="Background" Value="#1A2A1A"/>
                        </skia:SKDataTrigger.Setters>
                    </skia:SKDataTrigger>
                </skia:SKRowTemplate>
            </skia:SkiaGridViewV2.RowTemplate>

            <skia:SkiaGridViewV2.Columns>
                <skia:SKGridViewColumn Header="Strike" BindingPath="Strike" Width="80" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Header="Expiry" BindingPath="Expiry" Width="70" ContentAlignment="Center"/>
                <skia:SKGridViewColumn Header="Last" BindingPath="Last" Width="70" ContentAlignment="Right" Format="N2">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKCellTemplate.Setters>
                                <skia:SKSetter Property="Foreground" ValuePath="TrendColor"/>
                            </skia:SKCellTemplate.Setters>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Header="Bid" BindingPath="Bid" Width="70" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Header="Ask" BindingPath="Ask" Width="70" ContentAlignment="Right" Format="N2"/>
                <skia:SKGridViewColumn Header="Vol" BindingPath="Volume" Width="70" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Header="OI" BindingPath="OpenInterest" Width="70" ContentAlignment="Right" Format="N0"/>
                <skia:SKGridViewColumn Header="IV" BindingPath="ImpliedVol" Width="70" ContentAlignment="Right" Format="P1"/>
                <skia:SKGridViewColumn Header="Delta" BindingPath="Delta" Width="70" ContentAlignment="Right" Format="N4"/>
                <skia:SKGridViewColumn Header="Gamma" BindingPath="Gamma" Width="70" ContentAlignment="Right" Format="N4"/>
                <skia:SKGridViewColumn Header="Theta" BindingPath="Theta" Width="70" ContentAlignment="Right" Format="N4">
                    <skia:SKGridViewColumn.CellTemplate>
                        <skia:SKCellTemplate>
                            <skia:SKDataTrigger BindingPath="Theta" Operator="LessThan" Value="0">
                                <skia:SKDataTrigger.Setters>
                                    <skia:SKSetter Property="Foreground" Value="#FF6666"/>
                                </skia:SKDataTrigger.Setters>
                            </skia:SKDataTrigger>
                        </skia:SKCellTemplate>
                    </skia:SKGridViewColumn.CellTemplate>
                </skia:SKGridViewColumn>
                <skia:SKGridViewColumn Header="Vega" BindingPath="Vega" Width="70" ContentAlignment="Right" Format="N4"/>
                <skia:SKGridViewColumn Header="ITM" BindingPath="IsITM" Width="50" ContentAlignment="Center"/>
            </skia:SkiaGridViewV2.Columns>
        </skia:SkiaGridViewV2>

        <!-- Puts Grid -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="PUTS" FontWeight="Bold" FontSize="12" Foreground="#FF6666" Margin="10,5"/>
            <skia:SkiaGridViewV2 x:Name="putsGrid" Grid.Row="1"
                                 ItemsSource="{Binding Puts}"
                                 SelectedItems="{Binding SelectedPuts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ShowGridLines="True"
                                 GridLinesColor="#2A2A2A"
                                 RowBackground="#0D0D1A"
                                 AlternatingRowBackground="#12122A"
                                 ForegroundColor="#C0C0C0"
                                 CanUserSelectRows="True"
                                 CanUserSortColumns="True"
                                 CanUserResizeColumns="True"
                                 SKFontSize="12"
                                 SKFontFamily="Segoe UI"
                                 IsLiveSorting="True">

                <!-- ITM highlighting for puts -->
                <skia:SkiaGridViewV2.RowTemplate>
                    <skia:SKRowTemplate>
                        <skia:SKDataTrigger BindingPath="IsITM" Operator="Equals" Value="True">
                            <skia:SKDataTrigger.Setters>
                                <skia:SKSetter Property="Background" Value="#2A1A1A"/>
                            </skia:SKDataTrigger.Setters>
                        </skia:SKDataTrigger>
                    </skia:SKRowTemplate>
                </skia:SkiaGridViewV2.RowTemplate>

                <skia:SkiaGridViewV2.Columns>
                    <skia:SKGridViewColumn Header="Strike" BindingPath="Strike" Width="80" ContentAlignment="Right" Format="N2"/>
                    <skia:SKGridViewColumn Header="Expiry" BindingPath="Expiry" Width="70" ContentAlignment="Center"/>
                    <skia:SKGridViewColumn Header="Last" BindingPath="Last" Width="70" ContentAlignment="Right" Format="N2">
                        <skia:SKGridViewColumn.CellTemplate>
                            <skia:SKCellTemplate>
                                <skia:SKCellTemplate.Setters>
                                    <skia:SKSetter Property="Foreground" ValuePath="TrendColor"/>
                                </skia:SKCellTemplate.Setters>
                            </skia:SKCellTemplate>
                        </skia:SKGridViewColumn.CellTemplate>
                    </skia:SKGridViewColumn>
                    <skia:SKGridViewColumn Header="Bid" BindingPath="Bid" Width="70" ContentAlignment="Right" Format="N2"/>
                    <skia:SKGridViewColumn Header="Ask" BindingPath="Ask" Width="70" ContentAlignment="Right" Format="N2"/>
                    <skia:SKGridViewColumn Header="Vol" BindingPath="Volume" Width="70" ContentAlignment="Right" Format="N0"/>
                    <skia:SKGridViewColumn Header="OI" BindingPath="OpenInterest" Width="70" ContentAlignment="Right" Format="N0"/>
                    <skia:SKGridViewColumn Header="IV" BindingPath="ImpliedVol" Width="70" ContentAlignment="Right" Format="P1"/>
                    <skia:SKGridViewColumn Header="Delta" BindingPath="Delta" Width="70" ContentAlignment="Right" Format="N4"/>
                    <skia:SKGridViewColumn Header="Gamma" BindingPath="Gamma" Width="70" ContentAlignment="Right" Format="N4"/>
                    <skia:SKGridViewColumn Header="Theta" BindingPath="Theta" Width="70" ContentAlignment="Right" Format="N4">
                        <skia:SKGridViewColumn.CellTemplate>
                            <skia:SKCellTemplate>
                                <skia:SKDataTrigger BindingPath="Theta" Operator="LessThan" Value="0">
                                    <skia:SKDataTrigger.Setters>
                                        <skia:SKSetter Property="Foreground" Value="#FF6666"/>
                                    </skia:SKDataTrigger.Setters>
                                </skia:SKDataTrigger>
                            </skia:SKCellTemplate>
                        </skia:SKGridViewColumn.CellTemplate>
                    </skia:SKGridViewColumn>
                    <skia:SKGridViewColumn Header="Vega" BindingPath="Vega" Width="70" ContentAlignment="Right" Format="N4"/>
                    <skia:SKGridViewColumn Header="ITM" BindingPath="IsITM" Width="50" ContentAlignment="Center"/>
                </skia:SkiaGridViewV2.Columns>
            </skia:SkiaGridViewV2>
        </Grid>
    </Grid>
</UserControl>
