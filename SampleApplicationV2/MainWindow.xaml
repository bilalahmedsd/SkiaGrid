                                            </skia:SKGroupMultiTrigger.Setters>
                                        </skia:SKGroupMultiTrigger>
                                    </skia:SKGroupCellTemplate>
                                </skia:SKGroupField.GroupCellTemplate>
                            </skia:SKGroupField>
                            <skia:SKGroupField BindingPath="Discount" Aggregation="Sum"  TargetColumns="Discount"></skia:SKGroupField>
                            <skia:SKGroupField BindingPath="Category" Aggregation="Distinct"  TargetColumns="Category"></skia:SKGroupField>
                        </skia:SKGroupDefinition.HeaderFields>
