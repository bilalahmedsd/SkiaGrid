                                                <skia:SKGroupCondition BindingPath="Price" Aggregation="Sum" Operator="LessThanOrEqual" Value="0"></skia:SKGroupCondition>
                                            </skia:SKGroupMultiTrigger.Conditions>
                                            <skia:SKGroupMultiTrigger.Setters>
