<Window x:Class="SampleApplicationV2.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SampleApplicationV2.Views"
        Title="SkiaGridViewV2 - Trading Demo Showcase"
        Height="900" Width="1400"
        WindowState="Maximized"
        Background="#1A1A2E"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C0C0C0"/>
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab headers -->
        <TabControl x:Name="tabControl" Grid.Row="0" Background="#0D0D1A" BorderBrush="#333355" Foreground="#C0C0C0"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Performance" Tag="0"/>
            <TabItem Header="CollectionView" Tag="1"/>
            <TabItem Header="Multi-Window Test" Tag="2"/>
            <TabItem Header="Scroll Bar Gutter" Tag="3"/>
            <TabItem Header="Row Drag" Tag="4"/>
        </TabControl>

        <!-- Views stacked, visibility toggled -->
        <Grid Grid.Row="1">
            <views:PerformanceDashboardView x:Name="tab0" Visibility="Visible"/>
            <views:CollectionViewDemo x:Name="tab1" Visibility="Collapsed"/>
            <views:MultiWindowTestView x:Name="tab2" Visibility="Collapsed"/>
            <views:ScrollBarGutterView x:Name="tab3" Visibility="Collapsed"/>
            <views:RowDragView x:Name="tab4" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
