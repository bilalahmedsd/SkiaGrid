Color=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1085" target="c1086"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1097" value="property + direction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1091" target="c1086"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1098" value="ordered items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1086" target="c1087"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1099" value="&lt;b&gt;group-by fields,&lt;/b&gt;&lt;br&gt;expand state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1092" target="c1087"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1100" value="&lt;b&gt;sum / min / max /&lt;/b&gt;&lt;br&gt;avg / count" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1087" target="c1093"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1101" value="cached subtotals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="c1093" target="c1087"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1102" value="grouped result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1087" target="c1088"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1103" value="&lt;b&gt;materialised&lt;/b&gt;&lt;br&gt;view list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1088" target="c1089"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1104" value="&lt;b&gt;PERFORMANCE NOTES (why this pipeline is fast)&lt;/b&gt;&lt;br&gt;&lt;br&gt;2.1  O(1) filter-column lookup via HashSet; short-circuit when no filter is active.&lt;br&gt;2.2  One cached SortComparer instance reused across the whole sort - no per-item delegate allocation.&lt;br&gt;2.3  Groups indexed by key in a Dictionary; aggregates recomputed only for the group that changed.&lt;br&gt;2.4  Dirty flag coalesces a burst of source changes into ONE refresh per render tick,&lt;br&gt;      so a 1,000-tick-per-second market feed still costs at most one rebuild per frame." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="700" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Level 2 - Process 7.0 Render Pipeline" id="c1146"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1105" value="LEVEL 2  -  Process 7.0  Render Frame   (SkiaRenderer immediate-mode pipeline)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c1106" value="from 5.0  |  scroll offset" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="200" height="55" as="geometry"/></mxCell><mxCell id="c1107" value="D3  |  Flattened Row List" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="55" as="geometry"/></mxCell><mxCell id="c1108" value="D4  |  Column Definitions" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="200" height="55" as="geometry"/></mxCell><mxCell id="c1109" value="D5  |  Selection State" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="200" height="55" as="geometry"/></mxCell><mxCell id="c1110" value="D8  |  Paint + Font Cache" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="200" height="55" as="geometry"/></mxCell><mxCell id="c1111" value="&lt;b&gt;7.1&lt;/b&gt;&lt;br&gt;Compute Visible&lt;br&gt;Row Window" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeW