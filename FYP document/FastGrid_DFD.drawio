or=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1107" target="c1111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1124" value="&lt;b&gt;first index + count&lt;/b&gt;&lt;br&gt;(typically 30-60 rows)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1111" target="c1112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1125" value="&lt;b&gt;cached trigger&lt;/b&gt;&lt;br&gt;result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="c1120" target="c1112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1126" value="memoise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="c1112" target="c1120"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1127" value="column widths" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1108" target="c1112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1128" value="is row selected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1109" target="c1112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1129" value="SKPaint by colour" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;" edge="1" parent="1" source="c1110" target="c1112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1130" value="row style" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1112" target="c1113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1131" value="cell style" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1112" target="c1114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1132" value="group style" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1112" target="c1115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1133" value="button style" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1112" target="c1116"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1134" value="drag state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1112" target="c1117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1113" target="c1118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1136" value="&lt;b&gt;SKCanvas&lt;/b&gt;&lt;br&gt;draw calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1114" target="c1118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1137" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1115" target="c1118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1138" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1116" target="c1118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1139" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1117" target="c1118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1140" value="rendered frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1118" target="c1119"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1141" value="&lt;b&gt;frame time,&lt;/b&gt;&lt;br&gt;cells drawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c1118" target="c1121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1142" value="&lt;b&gt;WHY THIS BEATS ELEMENT-PER-CELL RENDERING&lt;/b&gt;&lt;br&gt;&lt;br&gt;WPF DataGrid (element per cell):&lt;br&gt;    100,000 rows x 12 columns = 1,200,000 visual elements&lt;br&gt;    every one measured, arranged and retained in the visual tree.&lt;br&gt;&lt;br&gt;FastGrid (immediate mode):&lt;br&gt;    only the ~40 rows inside the viewport are drawn = ~480 cells,&lt;br&gt;    zero visual elements, zero layout pass, zero allocations in&lt;br&gt;    the hot loop (SKPaint and typeface objects are cached).&lt;br&gt;&lt;br&gt;Cost is proportional to VIEWPORT SIZE, not to DATASET SIZE -&lt;br&gt;which is why frame time stays flat from 1,000 to 100,000 rows." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="930" width="760" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>