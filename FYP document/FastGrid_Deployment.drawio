<mxCell id="g5321" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="g5299" target="g5300"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g5322" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g5300" target="g5289"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g5323" value="&lt;b&gt;The two loops that matter&lt;/b&gt;&lt;br&gt;RENDER loop (red) runs per frame and touches only the viewport.&lt;br&gt;DATA loop (blue) runs per source change and is coalesced to at most&lt;br&gt;one rebuild per frame, so a 1,000-tick-per-second feed cannot flood it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1020" y="700" width="420" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>