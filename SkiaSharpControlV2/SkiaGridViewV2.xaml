<UserControl x:Class="SkiaSharpControlV2.SkiaGridViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>


        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowBackground" Value="#181818" />
            <Setter Property="AlternatingRowBackground" Value="#0C0C0C" />
            <Setter Property="VerticalGridLinesBrush" Value="Gray" />
            <Setter Property="HorizontalGridLinesBrush" Value="Gray" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="EnableColumnVirtualization" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <Geometry x:Key="UpArrowGeometry">M 0 4 L 8 4 L 4 0 Z</Geometry>
        <Geometry x:Key="DownArrowGeometry">M 0 0 L 4 4 L 8 0 Z</Geometry>

        <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <!-- left + bottom: the vertical rule between headers plus a 1 px rule under the whole
                 header band, matching the reference terminal (was left-only before v2.14.0). -->
            <Setter Property="BorderThickness" Value="1,0,0,1"/>
            <!-- Header separator / background / text default to the reference trading terminal's
                 values (#1E1E1E / #343434 / #E6E6E6). Each is overridable per grid via the
                 ColumnHeaderSeparatorColor / ColumnHeaderBackground / ColumnHeaderForeground DPs. -->
            <Setter Property="BorderBrush" Value="#FF1E1E1E" />
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF343434"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="Padding" Value="5,3,5,3" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" MinWidth="{TemplateBinding MinWidth}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- VerticalAlignment=Center: the header text used to sit at the top
                                     of the header band (Padding top 3). Now that the header height is
                                     independent of the font size it must stay centred at any height.
                                     Foreground is TemplateBound so the style setter / the
                                     ColumnHeaderForeground DP actually reaches the glyphs. -->
                                <TextBlock x:Name="ContentHeader" Text="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Width="{TemplateBinding Width}" TextAlignment="Left" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <!--<Path x:Name="SortArrow" Grid.Column="1" Margin="0,0,5,0" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Center" />-->
                                <TextBlock x:Name="SortArrow" Grid.Column="1"  Foreground="White" VerticalAlignment="Center" FontSize="{Binding ElementName=ContentHeader, Path=FontSize}" HorizontalAlignment="Center" />
                                <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"/>
                                <Thumb Grid.Column="2" x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value="⏶"  />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Text" Value="⏷" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <!-- LostFocus="SkiaCanvas_LostFocus" MouseDown="MainGrid_MouseDown"-->

    <Grid x:Name="MainGrid" MouseWheel="MainGrid_MouseWheel"  MouseDown="MainGrid_MouseDown" LostFocus="MainGrid_LostFocus">
        <!-- Custom Scroll Bar -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto"/>
            <!-- Scroll bar width -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- 18 = default SKFontSize (11) + the default Compact density's header padding (7).
                 Overwritten from _appearanceConfig.ColumnHeaderHeight on Loaded and whenever
                 SKFontSize / Density / SKColumnHeaderHeight / ColumnHeaderVisible change. -->
            <RowDefinition Height="18" x:Name="SKGridColumnHeader">

            </RowDefinition>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <DataGrid Grid.Row="0" 
                  Grid.Column="0"
                  x:Name="DataListView"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                  ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                  Background="Black" 
                  BorderThickness="0"
                  HorizontalAlignment="Left"     
                  HeadersVisibility="Column"
                  Sorting="DataListView_Sorting"
                  ColumnReordered="DataListView_ColumnReordered"
                  LayoutUpdated="DataListView_LayoutUpdated"
                  ColumnReordering="DataListView_ColumnReordering"
                  >
        </DataGrid>
        <StackPanel   Background="Transparent"  x:Name="skiaContainer" PreviewMouseDown="skiaContainer_PreviewMouseDown" Grid.Row="1"  Grid.Column="0"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            <skia:SKElement  
                x:Name="SkiaCanvas" 
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                PaintSurface="SkiaCanvas_PaintSurface"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                MouseRightButtonDown="SkiaCanvas_MouseRightButtonDown"
                MouseLeftButtonDown="SkiaCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="SkiaCanvas_MouseLeftButtonUp"
                LostMouseCapture="SkiaCanvas_LostMouseCapture"
                MouseMove="SkiaCanvas_MouseMove"
                MouseLeave="SkiaCanvas_MouseLeave"
                KeyDown="SkiaCanvas_KeyDown"
                />
        </StackPanel>
        <!-- Width left unset: WPF's ScrollBar style supplies the system metric (~17 px). The
             VerticalScrollBarWidth DP overrides it (Width + MinWidth, via ApplyScrollBarMetrics)
             and 0 clears both back to this default. -->
        <ScrollBar
            x:Name="VerticalScrollViewer"
            AutomationProperties.AutomationId="ScrollBar_Vertical"
            Grid.RowSpan="2"
            Orientation="Vertical"
            Minimum="0"
            SmallChange="1"
            LargeChange="1"
            Grid.Column="1"
            ContextMenu="{x:Null}"
            PreviewMouseLeftButtonUp="VerticalScrollViewer_PreviewMouseLeftButtonUp"
            Scroll="VerticalScrollViewer_Scroll"
            ValueChanged="VerticalScrollViewer_ValueChanged"
            />
        <!-- Height 20 = the historic built-in value, kept as the default. Overwritten from
             _appearanceConfig.HorizontalScrollBarHeight on Loaded and whenever the
             HorizontalScrollBarHeight DP changes; that DP's 0 comes back to this same 20. -->
        <ScrollBar
            x:Name="HorizontalScrollViewer"
            AutomationProperties.AutomationId="ScrollBar_Horizontal"
            Grid.Row="2"
            Height="20"
            Orientation="Horizontal"
            Minimum="0"
            SmallChange="1"
            LargeChange="1"
            ContextMenu="{x:Null}"
            PreviewMouseLeftButtonUp="HorizontalScrollViewer_PreviewMouseLeftButtonUp"
            Scroll="HorizontalScrollViewer_Scroll"
            ValueChanged="HorizontalScrollViewer_ValueChanged"
            />
    </Grid>
</UserControl>
